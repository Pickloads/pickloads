# =============================================================================
# PickLoads — E2E lane environment. COMMITTED ON PURPOSE.
# =============================================================================
#
# There is not a single secret in this file and there must never be one. Every
# value is a deterministic placeholder chosen so the application takes its
# GRACEFUL-DEGRADATION path rather than its configured path.
#
# WHY IT EXISTS. `.env.example` ships empty values. An empty
# NEXT_PUBLIC_SUPABASE_URL makes `createServerClient` throw inside middleware,
# so `next start` 500s on the first request and Playwright's webServer never
# comes up — the suite could not run even with a working browser. Nothing
# documented the values needed to get past that, so the "secretless lane"
# every module doc refers to was reproducible only by whoever first set it up.
#
# WHY THESE VALUES. The codebase already treats the literal substring
# "placeholder" as "not configured" — see the create-account pages and
# ForgotPasswordForm, which switch to their honest unavailable state on
# `NEXT_PUBLIC_SUPABASE_URL.includes("placeholder")`. Keeping that substring is
# what makes the e2e suite a proof of the degradation contracts (M-41), not
# merely a smoke test that happens to pass.
#
# WHY IT IS NOT `.env.local`. `.env.local` is developer-owned and gitignored.
# This file is loaded explicitly, only by `npm run build:e2e` and
# `npm run test:e2e`, through `scripts/with-e2e-env.mjs`. A normal
# `npm run build` is completely unaffected, so production environment
# validation keeps its teeth.
#
# NEXT_PUBLIC_* values are inlined by Next at BUILD time, which is why the
# build has its own script. Building without them and testing with them would
# ship a bundle that disagrees with its own server.
# =============================================================================

NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4321

# Syntactically valid, resolvable-looking, and deliberately unreachable.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key-not-a-secret

# Deliberately absent below this line: SUPABASE_SERVICE_ROLE_KEY,
# TURNSTILE_SECRET_KEY, UPSTASH_*, RESEND_API_KEY, STRIPE_*, DROPBOX_SIGN_*,
# PII_ENCRYPTION_KEY, CRON_SECRET, SENTRY_*. Each one absent is a contract the
# suite proves: the guard no-ops, the write is skipped, the email is logged
# rather than sent, and the action reports honestly instead of crashing.
