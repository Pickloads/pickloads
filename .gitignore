# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the e2e lane's, which is committed on purpose and holds no secret.
# See .env.e2e's own header for why, and scripts/with-e2e-env.mjs for how it
# is loaded (explicitly, for two commands, never automatically).
!.env.e2e

# vercel
.vercel

# supabase CLI scratch. Holds no secret VALUE — project ref, pooler URL
# (username, no password) and pinned service versions — but it is machine
# state, it changes on every `supabase link`, and it is exactly the kind of
# directory a credential later gets written into. Ignored before that
# happens rather than after (SEC-P3-01).
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
